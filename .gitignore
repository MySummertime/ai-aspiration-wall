# ── 依赖 ──────────────────────────────────────────────
node_modules/
# 云函数依赖同样忽略（约 40MB，且必须与云端运行时一致，不入库）
cloudfunctions/*/node_modules/
.pnp
.pnp.js

# ── 构建产物 ──────────────────────────────────────────
dist/
dist-ssr/
*.tsbuildinfo
tsconfig.tsbuildinfo

# ── 环境变量与密钥：绝不入库 ──────────────────────────
# .env.example 是模板，需要入库供他人复制
.env
.env.*
!.env.example

# ── 日志 ──────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── 测试与部署临时产物 ────────────────────────────────
coverage/
*.zip
.tcb/

# ── 编辑器与系统 ──────────────────────────────────────
.DS_Store
.vscode/*
!.vscode/extensions.json
.idea
*.swp
Thumbs.db
