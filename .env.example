# CloudBase 环境 ID
# 控制台 → 云开发 → 环境 → 环境 ID，形如 xxx-8gxxxxxx
VITE_ENV_ID=your-env-id

# Publishable Key（发布版密钥）
# 控制台 → 认证鉴权 / 安全配置 → 密钥 → Publishable Key
# ⚠️ 只能填 Publishable Key，绝不能填 Secret Key：
#   这个变量会被打包进前端产物，Secret Key 会直接泄露。
VITE_ACCESS_KEY=

# 演示模式：true = 用预置假数据、不调 AI；false = 真实调用 AI
VITE_DEMO_MODE=false

# 免鉴权 HTTP 访问服务端点（云函数 aiGen）
# 用途：绕开「匿名用户角色无云函数权限」导致的 PERMISSION_DENIED
# 部署 aiGen 后形如 https://<envId>.service.tcloudbase.com/aiGen
# 留空则回退到 app.callFunction('genCard')（本环境下该链路会被权限拒绝）
VITE_AI_HTTP_URL=
